# Application Settings
APP_NAME="LEO Labor Law Chatbot"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Settings
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Security Settings
JWT_SECRET_KEY="your-secret-key-here-change-in-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_CONVERSATIONS_PER_MINUTE=100

# OpenAI Settings
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_LLM_MODEL="gpt-4.1"  # For chat pipeline response generation
OPENAI_INGESTION_MODEL="gpt-4o"  # For KB ingestion (chunking, analysis)
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# Supabase Settings
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key-here"
# SUPABASE_DB_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# Vector Store Settings
VECTORSTORE_TABLE_NAME="labor_law_sections"
EMBEDDING_DIMENSION=1536
RETRIEVAL_TOP_K=5
RETRIEVAL_MODE=none  # hybrid | dense | lexical | symbolic | none

# Google Cloud Settings (Optional)
ENABLE_TRANSLATION=false
# GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
# GOOGLE_TRANSLATE_API_KEY="your-google-translate-api-key"
# GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# NLP Settings
ENABLE_INTENT_CLASSIFICATION=true
INTENT_CONFIDENCE_THRESHOLD=0.7

# Chat Settings
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_HISTORY=10

# Moderation Settings
ENABLE_MODERATION=true
MODERATION_FAIL_ON_VIOLATION=true

# Performance Settings
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
